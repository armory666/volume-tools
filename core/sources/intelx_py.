import os, httpx, asyncio
from core.models import Hit

KEY = os.environ.get("INTELX_KEY", "")

class IntelX:
    name = "intelx"
    accepts = ("email", "username", "domain", "ip", "phone")
    free = False
    pillar = "breach"

    async def query(self, seed, kind):
        if not KEY:
            return []
        try:
            async with httpx.AsyncClient(timeout=25) as c:
                # FREE INSTANCE — works with intelx.io free-tier keys
                s = await c.post(
                    "https://free.intelx.io/intelligent/search",
                    headers={"x-key": KEY},
                    json={"term": seed, "maxresults": 25, "media": 0, "sort": 4},
                )
                if s.status_code != 200:
                    return []
                sid = s.json().get("id")
                if not sid:
                    return []
                # free instance needs a moment to index the search
                await asyncio.sleep(2)
                rr = await c.get(
                    "https://free.intelx.io/intelligent/search/result",
                    params={"id": sid, "limit": 25},
                    headers={"x-key": KEY},
                )
                if rr.status_code != 200:
                    return []
                hits = []
                for rec in rr.json().get("records", []):
                    hits.append(Hit(self.name, "intelx_hit", rec.get("name") or seed, {
                        "bucket": rec.get("bucket"),
                        "date": rec.get("date"),
                        "media": rec.get("media"),
                        "type": rec.get("type"),
                        "storageid": rec.get("storageid"),
                    }))
                return hits
        except Exception:
            return []
