# ---------------------------------------------------------------------------
# VOLUME configuration
#
# Copy this file to `.env` in the same folder as the `volume` package and fill
# in the keys you have. Every key is optional: modules degrade gracefully and
# tell you which key would unlock more data.
#
# You can also put keys in `data/keys.json` as {"hibp": "...", "vt": "..."}.
# ---------------------------------------------------------------------------

# --- Device / licensing -----------------------------------------------------
# Secret ghost admin key. If unset, no ghost access is possible.
# VOLUME_GHOST_KEY=CHANGE-ME-BEFORE-DISTRIBUTING

# Founder account. The founder username is reserved; registering it (or
# claiming an existing account) requires the matching secret token below.
# Leave the token empty to keep the founder role locked on a fresh install.
VOLUME_FOUNDER=armory
VOLUME_FOUNDER_TOKEN=

# Force the layout: pc | mobile
# VOLUME_UI=pc

# Store runtime state (data/, exports/, logs/) somewhere else.
# VOLUME_HOME=C:\path\to\volume-home

# --- Breach / identity ------------------------------------------------------
# Have I Been Pwned: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# LeakIX (optional, raises limits): https://leakix.net/
LEAKIX_API_KEY=

# EmailRep (optional, raises limits): https://emailrep.io/key
EMAILREP_API_KEY=

# Numverify phone validation (optional): https://numverify.com/
NUMVERIFY_API_KEY=

# --- Threat intelligence ----------------------------------------------------
# VirusTotal: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# abuse.ch (MalwareBazaar + ThreatFox): https://auth.abuse.ch/
ABUSECH_API_KEY=

# URLhaus (abuse.ch) legacy Auth-Key, optional
URLHAUS_API_KEY=

# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# GreyNoise: https://viz.greynoise.io/account/api-key
GREYNOISE_API_KEY=

# Google Safe Browsing: https://developers.google.com/safe-browsing/v4/get-started
GSB_API_KEY=

# --- Vulnerability data -----------------------------------------------------
# NIST NVD (optional, raises rate limit): https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- OSINT ------------------------------------------------------------------
# GitHub token (optional, raises limit 60 -> 5000 req/hour):
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Telegram Bot API token (optional, chat lookup): https://core.telegram.org/bots
TELEGRAM=

# --- Discord ----------------------------------------------------------------
# Bot token (profile, member search, history lookups)
DISCORD_API_KEY=

# Self-hosted name/message history service
DISCORD_HISTORY_URL=

# Self-hosted Discord -> Roblox mapping service
ROBLOX_MAP_URL=

# --- Key-gated connectors ---------------------------------------------------
# These modules never ship private data. Point them at a service you are
# authorised to use, or leave them blank and the module will explain setup.
# nazAPI
NAZAPI_API_KEY=
NAZAPI_URL=

# Kitty DB-compatible index
KITTY_API_KEY=
KITTY_URL=

# Stealer-log index
STEALER_API_KEY=
STEALER_URL=

# Xbox (XAPI / OpenXBL)
XBOX_API_KEY=

# GHunt (self-hosted)
GHUNT_API_KEY=
GHUNT_URL=

# DVLA Vehicle Enquiry (vehicle data only)
DVLA_API_KEY=

# holehe (self-hosted)
HOLEHE_API_KEY=
HOLEHE_API_URL=
