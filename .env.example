# ---------------------------------------------------------------------------
# VOLUME configuration
#
# Copy this file to `.env` in the same folder as the `volume` package and fill
# in the keys you have. Every key is optional: modules degrade gracefully and
# tell you which key would unlock more data.
#
# You can also put keys in `data/keys.json` as {"hibp": "...", "vt": "..."}.
# ---------------------------------------------------------------------------

# --- Device / licensing -----------------------------------------------------
# Secret ghost admin key. If unset, no ghost access is possible.
# VOLUME_GHOST_KEY=CHANGE-ME-BEFORE-DISTRIBUTING

# Founder account. The founder username is reserved; registering it (or
# claiming an existing account) requires the matching secret token below.
# Leave the token empty to keep the founder role locked on a fresh install.
VOLUME_FOUNDER=armory
VOLUME_FOUNDER_TOKEN=

# Force the layout: pc | mobile
# VOLUME_UI=pc

# Store runtime state (data/, exports/, logs/) somewhere else.
# VOLUME_HOME=C:\path\to\volume-home

# --- Breach / identity ------------------------------------------------------
# Have I Been Pwned: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# LeakIX (optional, raises limits): https://leakix.net/
LEAKIX_API_KEY=

# EmailRep (optional, raises limits): https://emailrep.io/key
EMAILREP_API_KEY=

# Numverify phone validation (optional): https://numverify.com/
NUMVERIFY_API_KEY=

# --- Threat intelligence ----------------------------------------------------
# VirusTotal: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# abuse.ch (MalwareBazaar + ThreatFox): https://auth.abuse.ch/
ABUSECH_API_KEY=

# URLhaus (abuse.ch) legacy Auth-Key, optional
URLHAUS_API_KEY=

# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# GreyNoise: https://viz.greynoise.io/account/api-key
GREYNOISE_API_KEY=

# Google Safe Browsing: https://developers.google.com/safe-browsing/v4/get-started
GSB_API_KEY=

# --- Vulnerability data -----------------------------------------------------
# NIST NVD (optional, raises rate limit): https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- OSINT ------------------------------------------------------------------
# GitHub token (optional, raises limit 60 -> 5000 req/hour):
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Telegram Bot API token (optional, chat lookup): https://core.telegram.org/bots
TELEGRAM=

# --- Discord ----------------------------------------------------------------
# Bot token (profile, member search, history lookups)
DISCORD_API_KEY=

# Self-hosted name/message history service
DISCORD_HISTORY_URL=

# Self-hosted Discord -> Roblox mapping service
ROBLOX_MAP_URL=

# --- Key-gated connectors ---------------------------------------------------
# These modules never ship private data. Point them at a service you are
# authorised to use, or leave them blank and the module will explain setup.
# nazAPI
NAZAPI_API_KEY=
NAZAPI_URL=

# Kitty DB-compatible index
KITTY_API_KEY=
KITTY_URL=

# Stealer-log index
STEALER_API_KEY=
STEALER_URL=

# Xbox (XAPI / OpenXBL)
XBOX_API_KEY=

# GHunt (self-hosted)
GHUNT_API_KEY=
GHUNT_URL=

# DVLA Vehicle Enquiry (vehicle data only)
DVLA_API_KEY=

# holehe (self-hosted)
HOLEHE_API_KEY=
HOLEHE_API_URL=

# ---------------------------------------------------------------------------
# Web API (FastAPI)
# ---------------------------------------------------------------------------
# Local development uses SQLite at volume/data/web.db automatically. In
# production set DATABASE_URL to a Postgres connection string (Neon, Render,
# Supabase, ...).
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Public origin used in magic links and WebAuthn. No trailing slash.
VOLUME_PUBLIC_URL=http://localhost:8000

# Comma-separated origins allowed to call the API.
VOLUME_WEB_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8765,http://127.0.0.1:8765,https://volume-tools-web.vercel.app

# Comma-separated emails that receive the admin console. Also honoured when a
# user's tier is set to "admin".
VOLUME_ADMIN_EMAILS=

# Optional shared secret for machine/admin calls (X-Admin-Key header).
VOLUME_ADMIN_KEY=

# Sessions, one-time codes and quotas
VOLUME_SESSION_TTL_HOURS=12
VOLUME_REMEMBER_DAYS=30
VOLUME_OTP_TTL_MINUTES=10
VOLUME_OTP_MAX_ATTEMPTS=5
VOLUME_OTP_RESEND_SECONDS=30
# Requests allowed per email and per IP inside the same window.
VOLUME_OTP_EMAIL_LIMIT=4
VOLUME_OTP_IP_LIMIT=15
VOLUME_OTP_WINDOW_SECONDS=900
VOLUME_MAGIC_TTL_MINUTES=15
VOLUME_WELCOME_CREDITS=50
VOLUME_REFERRAL_CREDITS=25

# --- Email delivery ---------------------------------------------------------
# console (default) prints codes to the server log, smtp uses any relay,
# resend uses https://resend.com.
VOLUME_EMAIL_PROVIDER=console
# Development only: return the code / magic link in the API response so the
# login page can show it. NEVER enable this on a public deployment.
VOLUME_DEV_CODES=false
VOLUME_EMAIL_FROM=VOLUME <no-reply@volume.tools>
VOLUME_EMAIL_REPLY_TO=

# SMTP (e.g. Gmail app password)
VOLUME_SMTP_HOST=
VOLUME_SMTP_PORT=587
VOLUME_SMTP_USER=
VOLUME_SMTP_PASSWORD=
VOLUME_SMTP_TLS=true
VOLUME_SMTP_SSL=false

# Resend
RESEND_API_KEY=

# --- Passkeys (WebAuthn) ----------------------------------------------------
# RP ID is the bare domain (no scheme). Origin is the full site origin.
VOLUME_WEBAUTHN_RP_ID=localhost
VOLUME_WEBAUTHN_RP_NAME=VOLUME
VOLUME_WEBAUTHN_ORIGIN=http://localhost:8000
VOLUME_WEBAUTHN_ORIGINS=http://localhost:8000

